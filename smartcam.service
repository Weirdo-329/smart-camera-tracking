[Unit]
Description=Smart Camera Tracking System
After=lightdm.service pwm-init.service
Wants=pwm-init.service

[Service]
Type=simple
User=orangepi
WorkingDirectory=/home/orangepi/Desktop/Graduation_project
Environment=DISPLAY=:0
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/python3 -u /home/orangepi/Desktop/Graduation_project/main.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
